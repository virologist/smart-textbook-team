{
  "version": "1.0.0",
  "updated": "2026-11-05",
  "note": "成员产物契约 SSOT（M2 部分落盘判据 + §3.3.2 数据传递协议的具体化）。编排者 spawn 前注入本契约，收件时用 scripts/contract_check.py 比对 must_produce —— 缺项判 PARTIAL，不静默当合格。",
  "placeholders": {
    "{ch}": "章节号，如 ch03",
    "{图号}": "图号，如 3-1",
    "{节号}": "节号，如 3.2",
    "{slug}": "英文 slug"
  },
  "members": {
    "didactic-architect": {
      "role": "教学设计",
      "must_produce": [
        "章节/{ch}/chapter_design.md"
      ],
      "must_not_write": [
        "章节/{ch}/draft.md",
        "章节/{ch}/sections/{节号}.md",
        "章节/{ch}/review/**"
      ],
      "timeout_budget_s": 900,
      "max_retry": 3,
      "on_partial": "BLOCK",
      "on_timeout": "TIMEOUT"
    },
    "literature-scout": {
      "role": "文献检索",
      "must_produce": [
        "知识库/retrieval/{ch}_{slug}.md"
      ],
      "must_not_write": [
        "章节/{ch}/draft.md",
        "章节/{ch}/chapter_design.md"
      ],
      "timeout_budget_s": 900,
      "max_retry": 3,
      "on_partial": "BLOCK",
      "on_timeout": "TIMEOUT"
    },
    "subject-writer": {
      "role": "章节撰写",
      "must_produce": [
        "章节/{ch}/draft.md"
      ],
      "must_not_write": [
        "章节/{ch}/chapter_design.md",
        "章节/{ch}/review/**",
        "章节/{ch}/figures/**"
      ],
      "timeout_budget_s": 1800,
      "max_retry": 3,
      "on_partial": "BLOCK",
      "on_timeout": "TIMEOUT",
      "note": "节级推进模式（>8000 字）下 must_produce 改为 章节/{ch}/sections/{节号}.md —— 由 contract_check.py --mode sections 切换"
    },
    "quality-examiner": {
      "role": "质量审查",
      "must_produce": [
        "章节/{ch}/review/round1_report.md",
        "章节/{ch}/review/round2_report.md",
        "章节/{ch}/review/round3_report.md",
        "章节/{ch}/review/proofread.md",
        "章节/{ch}/review/proofread_revisions.md",
        "章节/{ch}/review/r5_score.json",
        "章节/{ch}/sections/{节号}.verdict.md"
      ],
      "must_not_write": [
        "章节/{ch}/draft.md",
        "章节/{ch}/sections/{节号}.md",
        "章节/{ch}/chapter_design.md"
      ],
      "timeout_budget_s": 1200,
      "max_retry": 3,
      "on_partial": "BLOCK",
      "on_timeout": "TIMEOUT",
      "note": "B1 补全（Q4）：must_produce 原只登记 round1，R2-R5 中途断轮的 PARTIAL 检测会漏 proofread 三件套——现已登记 R1-R3 报告 + R4 校稿两件套。★G2（v2.10）：r5_score.json 为 R5 评分默认落盘路径——score_quality.py 无 --out 时默认写此路径，编排者 --produce 显式指定的路径优先于默认值；contract_check 在 review-proofread-score task_type 下必查此文件，运行时漏传 --produce 不再静默丢失。★G3（v2.10）：sections/{节号}.verdict.md 为节级审查 verdict（可选产物，task_type=review-section 时必查；节净字数 <800 字跳过节审则不产出，契约按「按需产物」处理——只在出现时校验合法性）。R45 合并派工（task_type=review-proofread-score）时用 --produce 显式给出 proofread 两件套+评分段路径。"
    },
    "visual-instructional-designer": {
      "role": "图表设计",
      "must_produce": [
        "章节/{ch}/figures/{图号}.md"
      ],
      "must_not_write": [
        "章节/{ch}/draft.md",
        "章节/{ch}/sections/{节号}.md",
        "章节/{ch}/review/**"
      ],
      "timeout_budget_s": 900,
      "max_retry": 3,
      "on_partial": "BLOCK",
      "on_timeout": "TIMEOUT"
    },
    "smart-textbook-team-team-lead": {
      "role": "编排",
      "must_produce": [
        "运行态/progress.md"
      ],
      "must_not_write": [
        "章节/{ch}/draft.md",
        "章节/{ch}/sections/{节号}.md",
        "章节/{ch}/chapter_design.md",
        "章节/{ch}/review/**",
        "章节/{ch}/figures/**"
      ],
      "timeout_budget_s": 3600,
      "max_retry": 3,
      "on_partial": "BLOCK",
      "on_timeout": "TIMEOUT",
      "note": "编排者代写成员产出文件 = 越界（契约三原则②）"
    }
  }
}