# 打包流程临时备份（evo 迭代时脚本自动生成，内容可从 git 历史/GitHub 恢复）
*.bak.*

# R3 真实跑批区（临时工作区，产物可由 git 历史复现，不入库）
.r3-run/

# WorkBuddy 会话临时文件（宿主预览会话标记，含会话 UUID，运行时产物不入库）
.pending-preview-session

# Python / pytest 运行态缓存（派生产物，不入分发包）
__pycache__/
*.pyc
.pytest_cache/

# 专家团项目级运行态目录（agent-harness-expert SOP：断点状态机 / wiki 底座），
# 内容可由流程重建，不入 git、不进分发包（2026-11-20 全量复测 BUG-5/R-M1/R-M2）
.harness-kb/
.wiki-creator/
